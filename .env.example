# ============================================================
# Imad Portfolio - Environment Variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`.
# ============================================================

# --- NextAuth / admin login ---
# Generate a secret: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Admin credentials for /admin
ADMIN_NAME="Imaduddeen Khan"
ADMIN_EMAIL="imad@example.com"

# Choose ONE of these:
ADMIN_PASSWORD="change-me-in-.env.local"
# ADMIN_PASSWORD_HASH="$2b$12$replace-with-output-of-npm-run-hash-password"

# --- Supabase database + storage ---
# Project Settings -> API
SUPABASE_URL="https://your-project.supabase.co"
# Use the service_role or secret server key here. Do NOT use the publishable / anon key.
SUPABASE_SERVICE_KEY="your-service-role-key"
SUPABASE_BUCKET="portfolios"

# --- Public site URL ---
# Render production example:
# NEXTAUTH_URL="https://your-service-name.onrender.com"
# NEXT_PUBLIC_SITE_URL="https://your-service-name.onrender.com"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Imad Portfolio"

NODE_ENV="development"